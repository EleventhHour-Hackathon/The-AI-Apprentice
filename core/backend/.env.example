# Copy to .env.development (local) and fill in. On Render these are set in the dashboard.

# Required
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
SUPABASE_DB_URL=

# Supabase Storage for recordings and clips (sb_secret_... or the legacy service_role key).
# Without it they wait on the server's disk.
SUPABASE_SECRET_KEY=
# Optional: the project URL; worked out from SUPABASE_DB_URL when empty.
SUPABASE_URL=

# Access key for the hosted backend: requests must send it as X-Tacit-Key.
# Leave empty locally to keep the backend open.
TACIT_ACCESS_KEY=

# Only used by ./start.sh --sync-agents when it pushes the ElevenLabs agents.
ELEVENLABS_VOICE_ID=
